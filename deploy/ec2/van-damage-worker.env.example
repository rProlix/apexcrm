# AWS credentials must come from the EC2 instance profile, not this file.
AWS_REGION=us-west-2
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/van-damage
S3_BUCKET=nexoranow-van-damage-production
# Scroll Experience jobs use the routed queue and private bucket above.
SCROLL_VIDEO_PROCESSING_CONCURRENCY=1
SCROLL_VIDEO_MAX_UPLOAD_BYTES=536870912
SCROLL_VIDEO_MAX_DURATION_SECONDS=180
SCROLL_VIDEO_MAX_SOURCE_WIDTH=3840
SCROLL_VIDEO_MAX_SOURCE_HEIGHT=3840
SCROLL_VIDEO_DESKTOP_MAX_WIDTH=1920
SCROLL_VIDEO_MOBILE_MAX_WIDTH=720
SCROLL_VIDEO_MIN_FREE_DISK_BYTES=2147483648

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

GOOGLE_GEMINI_API_KEY=replace-with-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
SLACK_TOKEN_ENCRYPTION_KEY=replace-with-the-existing-32-byte-or-base64-key

LOG_LEVEL=info
NODE_ENV=production
